<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ℹ️ О проекте — Телетекст Плеер</title>
  <link rel="stylesheet" href="/global.css">
  <meta
    http-equiv="Content-Security-Policy"
    content="default-src 'self'; img-src 'self' https://tele.assunayuuki.ru https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
  >
  <style>
    /* ── Scanline overlay ── */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.18) 2px,
        rgba(0,0,0,0.18) 4px
      );
      pointer-events: none;
      z-index: 9999;
    }

    /* ── Page wrapper ── */
    .about-wrap {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 16px 60px;
    }

    /* ── Hero ── */
    .hero {
      text-align: center;
      padding: 48px 0 36px;
      position: relative;
    }

    .hero-badge {
      display: inline-block;
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid rgba(0,255,153,0.35);
      padding: 3px 12px;
      border-radius: 2px;
      margin-bottom: 18px;
      opacity: 0.8;
    }

    .hero-title {
      font-size: clamp(1.6rem, 5vw, 2.8rem);
      color: var(--accent);
      text-shadow: 0 0 12px rgba(0,255,153,0.6), 0 0 30px rgba(0,255,153,0.2);
      letter-spacing: 0.05em;
      line-height: 1.1;
      animation: flicker 8s infinite;
    }

    .hero-subtitle {
      margin-top: 14px;
      color: rgba(224,240,224,0.6);
      font-size: 0.88rem;
      letter-spacing: 0.08em;
    }

    .hero-line {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      margin: 28px 0 0;
      box-shadow: 0 0 8px rgba(0,255,153,0.4);
    }

    @keyframes flicker {
      0%,95%,100%  { opacity: 1; }
      96%          { opacity: 0.85; }
      97%          { opacity: 1; }
      98%          { opacity: 0.9; }
    }

    /* ── Section header ── */
    .section-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 42px 0 18px;
    }

    .section-head-icon {
      font-size: 1rem;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(0,255,153,0.4);
      border-radius: 4px;
      background: rgba(0,255,153,0.05);
      flex-shrink: 0;
    }

    .section-head-title {
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      flex: 1;
    }

    .section-head-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, rgba(0,255,153,0.3), transparent);
    }

    /* ── Quote ── */
    .quote {
      position: relative;
      background: rgba(0,255,153,0.05);
      border-left: 2px solid var(--accent);
      padding: 14px 18px 14px 22px;
      border-radius: 0 4px 4px 0;
      color: rgba(224,240,224,0.7);
      font-size: 0.9rem;
      font-style: italic;
      letter-spacing: 0.02em;
    }

    .quote::before {
      content: '"';
      position: absolute;
      top: -8px;
      left: 10px;
      font-size: 3rem;
      color: rgba(0,255,153,0.15);
      font-style: normal;
      line-height: 1;
    }

    /* ── Feature cards ── */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
      gap: 10px;
    }

    .feature-card {
      background: var(--card-bg);
      border: 1px solid rgba(0,102,68,0.6);
      border-radius: 4px;
      padding: 14px 12px;
      text-align: center;
      font-size: 0.82rem;
      color: rgba(224,240,224,0.8);
      transition: var(--transition);
      position: relative;
      overflow: hidden;
      cursor: default;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(0,255,153,0.08) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .feature-card:hover {
      border-color: var(--accent);
      box-shadow: 0 0 14px rgba(0,255,153,0.15), inset 0 0 12px rgba(0,255,153,0.04);
    }

    .feature-card:hover::before { opacity: 1; }

    .feature-icon {
      display: block;
      font-size: 1.4rem;
      margin-bottom: 8px;
      filter: drop-shadow(0 0 4px rgba(0,255,153,0.5));
    }

    /* ── Changelog timeline ── */
    .changelog {
      position: relative;
      padding-left: 26px;
    }

    .changelog::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 8px;
      bottom: 8px;
      width: 1px;
      background: linear-gradient(180deg, var(--accent), rgba(0,255,153,0.1));
    }

    .cl-entry {
      position: relative;
      margin-bottom: 12px;
      background: var(--card-bg);
      border: 1px solid rgba(0,102,68,0.5);
      border-radius: 4px;
      padding: 12px 14px;
      transition: var(--transition);
    }

    .cl-entry:hover {
      border-color: rgba(0,255,153,0.4);
      background: var(--hover-bg);
    }

    .cl-entry::before {
      content: '';
      position: absolute;
      left: -22px;
      top: 50%;
      transform: translateY(-50%);
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      background: var(--bg);
      box-shadow: 0 0 6px rgba(0,255,153,0.6);
    }

    .cl-entry.feature::before { background: rgba(0,255,153,0.4); }
    .cl-entry.fix::before     { background: rgba(255,160,80,0.4); border-color: #ffa050; box-shadow: 0 0 6px rgba(255,160,80,0.5); }
    .cl-entry.ui::before      { background: rgba(100,180,255,0.4); border-color: #64b4ff; box-shadow: 0 0 6px rgba(100,180,255,0.5); }

    .cl-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 5px;
    }

    .cl-badge {
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 2px 7px;
      border-radius: 2px;
      font-weight: bold;
      flex-shrink: 0;
    }

    .cl-badge.feature { background: rgba(0,255,153,0.12); color: var(--accent); border: 1px solid rgba(0,255,153,0.3); }
    .cl-badge.fix     { background: rgba(255,160,80,0.12); color: #ffa050;       border: 1px solid rgba(255,160,80,0.3); }
    .cl-badge.ui      { background: rgba(100,180,255,0.12); color: #64b4ff;      border: 1px solid rgba(100,180,255,0.3); }

    .cl-title {
      font-size: 0.88rem;
      color: var(--fg);
      flex: 1;
    }

    .cl-desc {
      font-size: 0.77rem;
      color: rgba(224,240,224,0.5);
      line-height: 1.5;
    }

    .cl-date {
      font-size: 0.68rem;
      color: rgba(224,240,224,0.3);
      letter-spacing: 0.06em;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .cl-date::before {
      content: '▶';
      font-size: 0.5rem;
      color: var(--accent);
    }

    /* ── Controls table ── */
    .controls-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }

    .controls-table tr {
      border-bottom: 1px solid rgba(0,102,68,0.3);
      transition: background 0.15s;
    }

    .controls-table tr:last-child { border-bottom: none; }

    .controls-table tr:hover { background: var(--hover-bg); }

    .controls-table td {
      padding: 8px 12px;
      vertical-align: middle;
    }

    .key-cell {
      white-space: nowrap;
    }

    .kbd {
      display: inline-block;
      background: rgba(0,255,153,0.08);
      border: 1px solid rgba(0,255,153,0.3);
      border-bottom: 2px solid rgba(0,255,153,0.5);
      border-radius: 3px;
      padding: 2px 8px;
      font-size: 0.78rem;
      color: var(--accent);
      font-family: var(--font-mono);
    }

    .ctrl-desc {
      color: rgba(224,240,224,0.65);
    }

    /* ── File structure ── */
    .code-block {
      background: #080c0a;
      border: 1px solid rgba(0,102,68,0.5);
      border-radius: 4px;
      padding: 14px 16px;
      font-size: 0.82rem;
      color: rgba(0,255,153,0.75);
      line-height: 1.7;
      overflow-x: auto;
      position: relative;
    }

    .code-block::before {
      content: 'STRUCTURE';
      position: absolute;
      top: 8px;
      right: 12px;
      font-size: 0.58rem;
      letter-spacing: 0.15em;
      color: rgba(0,255,153,0.3);
    }

    .code-block .path-accent { color: var(--accent); }
    .code-block .path-dim    { color: rgba(0,255,153,0.35); }

    /* ── Author card ── */
    .author-card {
      background: var(--card-bg);
      border: 1px solid rgba(0,102,68,0.6);
      border-radius: 6px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      overflow: hidden;
      transition: var(--transition);
    }

    .author-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      opacity: 0.5;
    }

    .author-card:hover {
      border-color: rgba(0,255,153,0.4);
      box-shadow: var(--glow);
    }

    .author-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(0,255,153,0.5);
      box-shadow: 0 0 12px rgba(0,255,153,0.3);
      flex-shrink: 0;
    }

    .author-name {
      font-size: 1.05rem;
      font-weight: bold;
      color: #7289da;
      text-shadow: 0 0 8px rgba(114,137,218,0.4);
      margin-bottom: 4px;
    }

    .author-role {
      font-size: 0.75rem;
      color: rgba(224,240,224,0.4);
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .discord-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: #7289da;
      text-decoration: none;
      font-size: 0.8rem;
      border: 1px solid rgba(114,137,218,0.3);
      padding: 3px 10px;
      border-radius: 3px;
      transition: var(--transition);
    }

    .discord-link:hover {
      background: rgba(114,137,218,0.1);
      border-color: rgba(114,137,218,0.6);
    }

    /* ── Footer ── */
    .about-footer {
      margin-top: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 18px;
      border-top: 1px solid rgba(0,102,68,0.4);
      gap: 16px;
      flex-wrap: wrap;
    }

    .copyright {
      font-size: 0.72rem;
      color: rgba(224,240,224,0.25);
      letter-spacing: 0.08em;
    }

    .copyright span {
      color: rgba(0,255,153,0.4);
    }

    /* ── Intro text ── */
    .intro-text {
      font-size: 0.88rem;
      color: rgba(224,240,224,0.7);
      line-height: 1.75;
    }

    .intro-text strong {
      color: var(--accent);
    }

    /* ── Cursor blink ── */
    .cursor {
      display: inline-block;
      width: 8px;
      height: 1em;
      background: var(--accent);
      vertical-align: text-bottom;
      animation: blink 1.1s step-end infinite;
      box-shadow: 0 0 6px rgba(0,255,153,0.8);
    }

    @keyframes blink {
      0%,100% { opacity: 1; }
      50%      { opacity: 0; }
    }
  </style>
</head>
<body>

<div class="about-wrap">

  <!-- Hero -->
  <div class="hero">
    <div class="hero-badge">SYS::INFO v2.0</div>
    <h1 class="hero-title">📺 Телетекст Плеер<span class="cursor"></span></h1>
    <p class="hero-subtitle">Веб-архив телетекста · Ретро-плеер · Node.js + Express</p>
    <div class="hero-line"></div>
  </div>

  <!-- О проекте -->
  <div class="section-head">
    <div class="section-head-icon">▸</div>
    <div class="section-head-title">О проекте</div>
    <div class="section-head-line"></div>
  </div>

  <p class="intro-text">
    Веб-плеер архивов <strong>телетекста</strong> — системы распространения текстовой информации через
    телевизионный сигнал. Позволяет просматривать HTML-страницы с номерами <strong>100–999</strong>,
    листать подстраницы, управлять архивами и генерировать превью. Проект создан для атмосферного
    просмотра ретро-материалов.
  </p>

  <div class="quote" style="margin-top:18px;">
    Телетекст — это не просто информация, это атмосфера эпохи.
  </div>

  <!-- Возможности -->
  <div class="section-head">
    <div class="section-head-icon">◈</div>
    <div class="section-head-title">Возможности</div>
    <div class="section-head-line"></div>
  </div>

  <div class="features-grid">
    <div class="feature-card">
      <span class="feature-icon">📺</span>
      Просмотр страниц
    </div>
    <div class="feature-card">
      <span class="feature-icon">📁</span>
      Навигация по архивам
    </div>
    <div class="feature-card">
      <span class="feature-icon">🖼️</span>
      Превью страниц
    </div>
    <div class="feature-card">
      <span class="feature-icon">✏️</span>
      Редактирование карточек
    </div>
    <div class="feature-card">
      <span class="feature-icon">▶</span>
      Автоанимация подстраниц
    </div>
    <div class="feature-card">
      <span class="feature-icon">🗂️</span>
      Менеджер файлов
    </div>
  </div>

  <!-- Changelog -->
  <div class="section-head">
    <div class="section-head-icon">⌥</div>
    <div class="section-head-title">Последние обновления</div>
    <div class="section-head-line"></div>
  </div>

  <div class="cl-date">2026-03-29</div>

  <div class="changelog">
    <div class="cl-entry feature">
      <div class="cl-header">
        <span class="cl-badge feature">новое</span>
        <span class="cl-title">Подстраницы и автолистание</span>
      </div>
      <div class="cl-desc">
        Страницы телетекста теперь показывают все свои подстраницы. Можно переключаться вручную
        или запустить автолистание — как на настоящем телевизоре.
      </div>
    </div>

    <div class="cl-entry ui">
      <div class="cl-header">
        <span class="cl-badge ui">дизайн</span>
        <span class="cl-title">Обновлена страница редактирования канала</span>
      </div>
      <div class="cl-desc">
        Страница редактирования карточки канала получила новый визуальный стиль — стало удобнее и приятнее.
      </div>
    </div>
  </div>

  <!-- Управление -->
  <div class="section-head">
    <div class="section-head-icon">⌨</div>
    <div class="section-head-title">Управление</div>
    <div class="section-head-line"></div>
  </div>

  <table class="controls-table">
    <tr>
      <td class="key-cell"><span class="kbd">←</span> <span class="kbd">→</span></td>
      <td class="ctrl-desc">Переключение страниц</td>
    </tr>
    <tr>
      <td class="key-cell"><span class="kbd">Home</span> <span class="kbd">End</span></td>
      <td class="ctrl-desc">Перейти к первой / последней странице</td>
    </tr>
    <tr>
      <td class="key-cell"><span class="kbd">▶ / ⏸</span></td>
      <td class="ctrl-desc">Запуск / пауза автоанимации подстраниц</td>
    </tr>
    <tr>
      <td class="key-cell"><span class="kbd">🏠</span></td>
      <td class="ctrl-desc">Вернуться на главную</td>
    </tr>
    <tr>
      <td class="key-cell"><span class="kbd">📁</span></td>
      <td class="ctrl-desc">Открыть список страниц архива</td>
    </tr>
  </table>

  <!-- Автор -->
  <div class="section-head">
    <div class="section-head-icon">👤</div>
    <div class="section-head-title">Автор</div>
    <div class="section-head-line"></div>
  </div>

  <div class="author-card">
    <img src="https://tele.assunayuuki.ru/discord_avatar.webp" alt="AssunaYuuki" class="author-avatar">
    <div>
      <div class="author-name">AssunaYuuki</div>
      <div class="author-role">DEVELOPER · DESIGNER</div>
      <a href="https://discord.com/users/685118410002137181" class="discord-link" target="_blank">
