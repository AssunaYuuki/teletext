        Discord
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div class="about-footer">
    <a href="/" class="btn">← На главную</a>
    <div class="copyright">
      © <span>AssunaYuuki</span> 2026 · Teletext Player
    </div>
  </div>

</div>

</body>
