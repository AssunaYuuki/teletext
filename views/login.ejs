<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🔐 Авторизация — Телетекст Плеер</title>
  <link rel="stylesheet" href="/global.css">
  <style>
    .login-wrap { display:flex; align-items:center; justify-content:center; min-height:80vh; }
    .login-card { background:var(--card-bg); border:1px solid var(--accent); border-radius:8px; padding:30px; width:100%; max-width:360px; box-shadow:var(--glow); }
    .login-card h2 { text-align:center; margin-bottom:20px; color:var(--accent); text-shadow:0 0 8px rgba(0,255,153,0.5); }
    .field { margin-bottom:16px; }
    .field input { width:100%; padding:10px; background:rgba(0,20,10,0.7); border:1px solid rgba(0,255,153,0.3); border-radius:4px; color:var(--fg); font-family:var(--font-mono); font-size:0.95rem; }
    .field input:focus { border-color:var(--accent); outline:none; box-shadow:0 0 0 2px rgba(0,255,153,0.15); }
    .btn-submit { width:100%; padding:10px; background:var(--accent); color:var(--bg); border:none; border-radius:4px; font-family:var(--font-mono); font-weight:bold; cursor:pointer; transition:0.2s; }
    .btn-submit:hover { box-shadow:0 0 14px rgba(0,255,153,0.5); }
    .error-msg { color:#ff6666; font-size:0.8rem; text-align:center; margin-bottom:12px; display:none; }
    .error-msg.show { display:block; }
  </style>
</head>
<body class="crt">
  <div class="login-wrap">
    <form class="login-card" method="POST" action="/login">
      <h2>🔐 Доступ к управлению</h2>
      <div class="error-msg <%= error ? 'show' : '' %>">⚠️ Неверный пароль</div>
      <div class="field">
        <input type="password" name="password" placeholder="Введите пароль" required autofocus>
      </div>
      <button type="submit" class="btn-submit">Войти</button>
      <div style="text-align:center; margin-top:16px;">
        <a href="/" style="color:var(--accent); font-size:0.85rem; text-decoration:none;">← Вернуться к просмотру</a>
      </div>
    </form>
  </div>
</body>
</html>