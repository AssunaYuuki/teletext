<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Стр. <%= pageNumber %> — <%= folderName %></title>
<link rel="stylesheet" href="/global.css">
<style>
.page-container {
display: flex;
justify-content: center;
align-items: flex-start;
min-height: 100vh;
padding: 20px 10px;
background: var(--bg);
color: var(--fg);
font-family: var(--font-mono);
}
.content-wrapper {
width: 100%;
max-width: 820px;
margin: 0 auto;
display: flex;
flex-direction: column;
gap: 20px;
box-sizing: border-box;
}
.teletext-frame {
position: relative;
background: #000;
border: 2px solid #00ff88;
border-radius: 6px;
padding: 0;
box-shadow: 0 0 15px rgba(0, 255, 136, 0.3),
inset 0 0 8px rgba(0, 60, 30, 0.8);
overflow: hidden;
width: 100%;
max-width: 820px;
margin: 0 auto;
}
.subpage-switcher {
display: flex;
gap: 6px;
margin-bottom: 8px;
flex-wrap: wrap;
align-items: center;
}
.anim-controls {
display: flex;
align-items: center;
gap: 8px;
margin-bottom: 8px;
}
.anim-btn {
padding: 4px 12px;
background: var(--card-bg);
border: 1px solid var(--accent);
color: var(--accent);
font-family: var(--font-mono);
cursor: pointer;
font-size: 1rem;
}
.anim-btn.playing {
background: var(--accent);
color: #000;
}
.anim-speed {
display: flex;
align-items: center;
gap: 6px;
color: var(--fg);
font-family: var(--font-mono);
font-size: 0.85rem;
}
.anim-speed input[type=range] {
width: 100px;
accent-color: var(--accent);
}
.anim-counter {
color: var(--accent);
font-family: var(--font-mono);
font-size: 0.85rem;
min-width: 60px;
}
.sp-btn {
padding: 4px 10px;
background: var(--card-bg);
border: 1px solid var(--accent);
color: var(--accent);
font-family: var(--font-mono);
cursor: pointer;
}
.sp-btn.active {
background: var(--accent);
color: #000;
}
.thumbs-grid {
background: var(--card-bg);
border: 1px solid var(--accent);
border-radius: 4px;
padding: 15px;
box-shadow: 0 0 10px var(--shadow);
}
.thumbs-grid h3 {
color: var(--accent);
margin-bottom: 10px;
display: flex;
align-items: center;
gap: 8px;
text-shadow: 0 0 5px rgba(0, 255, 136, 0.4);
}
.thumbs-grid .grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
gap: 8px;
}
.thumbs-grid .thumb-item {
position: relative;
border: 1px solid var(--accent);
border-radius: 4px;
overflow: hidden;
transition: all 0.2s ease;
background: var(--hover-bg);
height: 140px;
display: flex;
flex-direction: column;
justify-content: space-between;
}
.thumbs-grid .thumb-item:hover {
transform: scale(1.05);
z-index: 10;
box-shadow: 0 0 10px var(--shadow);
}
.thumbs-grid .thumb-item img {
width: 100%;
height: 100px;
object-fit: cover;
display: block;
}
.thumbs-grid .thumb-item span {
display: block;
text-align: center;
color: var(--accent);
font-size: 0.9rem;
padding: 4px;
background: var(--card-bg);
font-weight: bold;
}
.nav-bar button, .nav-bar .btn-list {
margin: 0 4px;
padding: 6px 12px;
background: var(--card-bg);
border: 1px solid var(--accent);
color: var(--accent);
font-family: var(--font-mono);
cursor: pointer;
}
.nav-bar button:disabled {
opacity: 0.4;
cursor: not-allowed;
}
.nav-bar input {
width: 60px;
text-align: center;
padding: 4px;
background: var(--hover-bg);
border: 1px solid var(--accent);
color: var(--fg);
font-family: var(--font-mono);
}

/* === СТИЛИ ДЛЯ FASTEXT КНОПОК === */
.fastext-bar {
  display: flex;
  background: #000;
  border-top: 2px solid #555;
  margin-top: auto;
  border-radius: 0 0 6px 6px;
  overflow: hidden;
}
.fe-link {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  text-decoration: none;
  font-weight: bold;
  font-family: var(--font-mono);
  transition: 0.2s;
  border-right: 1px solid #333;
}
.fe-link:last-child { border-right: none; }
.fe-link:hover { filter: brightness(1.2); text-shadow: 0 0 5px currentColor; }
.fe-red { color: #ff3333; background: rgba(255, 51, 51, 0.1); }
.fe-green { color: #33ff33; background: rgba(51, 255, 51, 0.1); }
.fe-yellow { color: #ffff33; background: rgba(255, 255, 51, 0.1); }
.fe-blue { color: #3399ff; background: rgba(51, 153, 255, 0.1); }
.fe-label { margin-right: 4px; }
</style>
</head>
<body>
<!-- Навигация -->
<header class="nav-bar">
<div class="breadcrumb">
<a href="/">🏠</a>
<% if (breadcrumb && breadcrumb.length > 0) { %>
<% breadcrumb.forEach((crumb, i) => { %>
<% if (i === breadcrumb.length - 1) { %>
<span> → <%= crumb.name %></span>
<% } else { %>
<a href="/folder/<%= crumb.path %>"> → <%= crumb.name %></a>
<% } %>
<% }) %>
<% } %>
</div>
<h2>
<% if (hasLogo) { %>
<img id="header-logo" src="<%= logoUrl %>?t=<%= Date.now() %>" alt="Логотип" style="height:32px;vertical-align:middle;margin-right:8px;">
<% } %>
<%= folderName %> — Стр. <span id="current-page"><%= pageNumber %></span>
</h2>
<div style="margin-top: 8px;">
<button id="prev" title="Предыдущая (←)" <%= prevPage === null ? 'disabled' : '' %>>◄</button>
<input type="number" id="jump" min="100" max="9999" value="<%= pageNumber %>" size="3">
<button id="next" title="Следующая (→)" <%= nextPage === null ? 'disabled' : '' %>>►</button>
<a href="/folder/<%= currentPath %>" class="btn-list" style="display:inline-block; padding:6px 12px;">📁 Список</a>
</div>
</header>
<!-- Центральный контент -->
<div class="page-container">
<div class="content-wrapper">
<% if (subpages.length > 1) { %>
<div class="anim-controls">
<button class="anim-btn" id="anim-play" title="Автопоказ подстраниц">▶ Авто</button>
<div class="anim-speed">
<span>Скорость:</span>
<input type="range" id="anim-speed-range" min="100" max="3000" step="100" value="500">
<span id="anim-speed-label">0.5 с</span>
</div>
<span class="anim-counter" id="anim-counter"></span>
</div>
<div class="subpage-switcher">
<% subpages.forEach((sp, i) => { %>
<button class="sp-btn <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>"><%= i + 1 %></button>
<% }) %>
</div>
<% } %>
<div class="teletext-frame">
<iframe id="teletext-iframe"
scrolling="no"
style="border:none; width:100%; display:block;">
</iframe>
</div>

<!-- === БЛОК FASTEXT КНОПОК === -->
<% if (fastextLinks) { %>
<div class="fastext-bar">
  <% if (fastextLinks.red) { %>
    <a href="/page/<%= encodeURIComponent(currentPath) %>/<%= fastextLinks.red %>" class="fe-link fe-red">
      <span class="fe-label">🔴</span> <span class="fe-page"><%= fastextLinks.red %></span>
    </a>
  <% } else { %>
    <div class="fe-link fe-red" style="opacity: 0.3;"><span class="fe-label">🔴</span> —</div>
  <% } %>

  <% if (fastextLinks.green) { %>
    <a href="/page/<%= encodeURIComponent(currentPath) %>/<%= fastextLinks.green %>" class="fe-link fe-green">
      <span class="fe-label">🟢</span> <span class="fe-page"><%= fastextLinks.green %></span>
    </a>
  <% } else { %>
    <div class="fe-link fe-green" style="opacity: 0.3;"><span class="fe-label">🟢</span> —</div>
  <% } %>

  <% if (fastextLinks.yellow) { %>
    <a href="/page/<%= encodeURIComponent(currentPath) %>/<%= fastextLinks.yellow %>" class="fe-link fe-yellow">
      <span class="fe-label">🟡</span> <span class="fe-page"><%= fastextLinks.yellow %></span>
    </a>
  <% } else { %>
    <div class="fe-link fe-yellow" style="opacity: 0.3;"><span class="fe-label">🟡</span> —</div>
  <% } %>

  <% if (fastextLinks.blue) { %>
    <a href="/page/<%= encodeURIComponent(currentPath) %>/<%= fastextLinks.blue %>" class="fe-link fe-blue">
      <span class="fe-label">🔵</span> <span class="fe-page"><%= fastextLinks.blue %></span>
    </a>
  <% } else { %>
    <div class="fe-link fe-blue" style="opacity: 0.3;"><span class="fe-label">🔵</span> —</div>
  <% } %>
</div>
<% } %>
<!-- ============================ -->

<div class="thumbs-grid">
<h3>🖼️ Страницы</h3>
<div class="grid">
<% pageList.forEach(item => { %>
<a
href="/page/<%= currentPath %>/<%= item.page %>"
class="thumb-item <%= item.page === pageNumber ? 'active' : '' %>">
<% if (item.hasThumb) { %>
<img src="<%= `/teletext/${currentPath}/${item.page}.png` %>?t=<%= Date.now() %>" alt="Стр. <%= item.page %>" loading="lazy" style="width:100%; height:80px; object-fit:cover; border-radius:3px;">
<% } else { %>
<div style="height:80px; width:100%; background:#0a220a; display:flex; align-items:center; justify-content:center; color:#00ff88; font-size:1.1rem; font-weight:bold;">
<%= item.page %>
</div>
<% } %>
<span><%= item.page %></span>
</a>
<% }) %>
</div>
</div>
</div>
</div>
<script type="application/json" id="subpages-data"><%- JSON.stringify(subpages).replace(/<\/script>/gi, '<\\/script>') %></script>
<script>
const currentPath = `<%= currentPath %>`;
const currentPageNum = <%= pageNumber %>;
const prevPageNum = <%= prevPage !== null ? prevPage : 'null' %>;
const nextPageNum = <%= nextPage !== null ? nextPage : 'null' %>;
const allPageNumbers = [<%= pageList.map(p => p.page).join(',') %>];

// Данные Fastext для JS (чтобы работали горячие клавиши)
const fastextLinks = <%- JSON.stringify(fastextLinks || {}) %>;

function goToPage(num) {
if (num === null || !allPageNumbers.includes(num)) return;
const encodedPath = currentPath ? encodeURIComponent(currentPath) : '';
window.location.href = `/page/${encodedPath}/${num}`;
}

document.getElementById('prev').onclick = () => goToPage(prevPageNum);
document.getElementById('next').onclick = () => goToPage(nextPageNum);
document.getElementById('jump').onchange = (e) => {
const num = parseInt(e.target.value);
if (allPageNumbers.includes(num)) {
goToPage(num);
} else {
alert(`Страница ${num} отсутствует.
Доступные: ${allPageNumbers.join(', ')}`);
e.target.value = currentPageNum;
}
};

document.addEventListener('keydown', e => {
if (e.key === 'ArrowLeft' && prevPageNum !== null) goToPage(prevPageNum);
else if (e.key === 'ArrowRight' && nextPageNum !== null) goToPage(nextPageNum);
else if (e.key === 'Home' && allPageNumbers.length > 0) goToPage(allPageNumbers[0]);
else if (e.key === 'End' && allPageNumbers.length > 0) goToPage(allPageNumbers[allPageNumbers.length - 1]);
// Горячие клавиши для Fastext (1, 2, 3, 4)
else if (e.key === '1' && fastextLinks && fastextLinks.red) goToPage(parseInt(fastextLinks.red));
else if (e.key === '2' && fastextLinks && fastextLinks.green) goToPage(parseInt(fastextLinks.green));
else if (e.key === '3' && fastextLinks && fastextLinks.yellow) goToPage(parseInt(fastextLinks.yellow));
else if (e.key === '4' && fastextLinks && fastextLinks.blue) goToPage(parseInt(fastextLinks.blue));
});

const subpages = JSON.parse(document.getElementById('subpages-data').textContent);
const iframe = document.getElementById('teletext-iframe');
function fitIframe() {
try {
const h = iframe.contentDocument.body.scrollHeight;
if (h > 0) iframe.style.height = h + 'px';
} catch(e) {}
}
function showSubpage(index) {
iframe.srcdoc = subpages[index].html;
iframe.onload = fitIframe;
document.querySelectorAll('.sp-btn').forEach((btn, i) => {
btn.classList.toggle('active', i === index);
});
}
document.querySelectorAll('.sp-btn').forEach(btn => {
btn.addEventListener('click', () => showSubpage(parseInt(btn.dataset.index)));
});
showSubpage(0);
// --- Автоанимация подстраниц ---
if (subpages.length > 1) {
let animTimer = null;
let currentSubpageIndex = 0;
const playBtn = document.getElementById('anim-play');
const speedRange = document.getElementById('anim-speed-range');
const speedLabel = document.getElementById('anim-speed-label');
const counter = document.getElementById('anim-counter');
function updateCounter() {
counter.textContent = `${currentSubpageIndex + 1} / ${subpages.length}`;
}
updateCounter();
function animStep() {
currentSubpageIndex = (currentSubpageIndex + 1) % subpages.length;
showSubpage(currentSubpageIndex);
updateCounter();
}
function getInterval() {
return parseInt(speedRange.value, 10);
}
function startAnim() {
if (animTimer) clearInterval(animTimer);
animTimer = setInterval(animStep, getInterval());
playBtn.textContent = '⏸ Пауза';
playBtn.classList.add('playing');
}
function stopAnim() {
clearInterval(animTimer);
animTimer = null;
playBtn.textContent = '▶ Авто';
playBtn.classList.remove('playing');
}
playBtn.addEventListener('click', () => {
if (animTimer) stopAnim(); else startAnim();
});
speedRange.addEventListener('input', () => {
const ms = parseInt(speedRange.value, 10);
speedLabel.textContent = ms >= 1000 ? (ms / 1000).toFixed(1) + ' с' : ms + ' мс';
if (animTimer) {
clearInterval(animTimer);
animTimer = setInterval(animStep, ms);
}
});
document.querySelectorAll('.sp-btn').forEach((btn, i) => {
btn.addEventListener('click', () => {
stopAnim();
currentSubpageIndex = i;
updateCounter();
});
});
}
</script>
</body>
</html>