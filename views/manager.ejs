<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>📁 Менеджер архивов</title>
<link rel="stylesheet" href="/global.css">
<style>
.manager-container { max-width: 1000px; margin: 0 auto; padding: 20px; }
.controls { background: var(--card-bg); padding: 15px; border-radius: 6px; border: 1px solid var(--accent); margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.controls input, .controls button { padding: 8px 12px; background: var(--hover-bg); border: 1px solid var(--accent); color: var(--fg); font-family: var(--font-mono); border-radius: 4px; }
.controls button { cursor: pointer; transition: all 0.2s ease; }
.controls button:hover { background: var(--accent); color: var(--bg); box-shadow: var(--glow); }
.breadcrumb { font-size: 0.9rem; margin-bottom: 10px; }
.breadcrumb a { color: var(--accent); text-decoration: none; }
.breadcrumb a:hover { text-decoration: underline; }
.items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
.item-card { background: var(--card-bg); border: 1px solid var(--accent); border-radius: 6px; padding: 10px; text-align: center; transition: all 0.2s ease; position: relative; }
.item-card:hover { background: var(--hover-bg); transform: translateY(-3px); box-shadow: 0 4px 12px var(--shadow); }
.item-card.folder { color: #ffcc00; }
.item-card.file { color: #a0d9a0; }
.item-actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; }
.item-actions button, .item-actions a { background: rgba(0,0,0,0.5); border: none; color: #ff6666; cursor: pointer; font-size: 0.8rem; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s; text-decoration: none; }
.item-actions button:hover, .item-actions a:hover { background: #ff6666; color: var(--bg); }
.item-preview { margin: 8px 0; font-size: 1.2rem; }
.item-preview img { width: 40px; height: 40px; object-fit: cover; border-radius: 3px; }
.item-name { font-size: 0.85rem; word-break: break-word; margin-top: 5px; }
.item-size { font-size: 0.75rem; opacity: 0.7; }
.empty-state { text-align: center; padding: 40px; opacity: 0.7; }
#drop-zone.drag-over { background: rgba(0,255,153,0.1); border-color: #00ffaa; }
#drop-zone.drag-over div { background: rgba(0,255,153,0.2); }
.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.7); justify-content: center; align-items: center; }
.modal-content { background: var(--card-bg); border: 2px solid var(--accent); border-radius: 6px; padding: 20px; max-width: 600px; width: 90%; box-shadow: 0 0 20px var(--glow); position: relative; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.modal-title { color: var(--accent); font-size: 1.2rem; }
.close { color: #ff6666; font-size: 1.5rem; font-weight: bold; cursor: pointer; }
.modal-body { color: var(--fg); font-size: 0.9rem; margin-bottom: 15px; }
.modal-footer { margin-top: 15px; text-align: right; }
.btn-action, .btn-cancel { padding: 6px 12px; border: 1px solid var(--accent); border-radius: 4px; cursor: pointer; margin-left: 6px; font-family: var(--font-mono); }
.btn-action { background: var(--card-bg); color: var(--accent); }
.btn-action:hover { background: var(--accent); color: var(--bg); }
.btn-cancel { background: var(--card-bg); color: var(--accent); }
.btn-cancel:hover { background: var(--accent); color: var(--bg); }
.move-modal-body { display: flex; flex-direction: column; gap: 10px; }
.move-modal-input { width: 100%; padding: 8px; background: var(--hover-bg); border: 1px solid var(--accent); color: var(--fg); font-family: var(--font-mono); border-radius: 4px; }
.move-modal-info { font-size: 0.85rem; opacity: 0.7; }
#progress-container, #regenerate-progress-container { display: none; margin-top: 10px; }
#progress-bar, #regenerate-progress-bar { height: 4px; background: var(--accent); width: 0%; border-radius: 2px; transition: width 0.3s ease; }
#progress-text, #regenerate-progress-text { font-size: 0.85rem; color: var(--accent); margin-top: 5px; }
</style>
</head>
<body>
<header class="nav-bar">
  <div class="breadcrumb">
    <a href="/">🏠</a>
    <a href="/manager/"> / teletext</a>
    <% if (breadcrumb && breadcrumb.length > 0) { %>
      <% breadcrumb.forEach((crumb, i) => { %>
        <% if (i === breadcrumb.length - 1) { %>
          <span> → <%= crumb.name %></span>
        <% } else { %>
          <a href="/manager/<%= encodeURIComponent(crumb.path) %>"> → <%= crumb.name %></a>
        <% } %>
      <% }) %>
    <% } %>
  </div>
  <h2>📁 Менеджер архивов</h2>
</header>

<div class="manager-container">
  <div class="controls">
    <input type="text" id="folder-name" placeholder="Имя новой папки">
    <button onclick="createFolder()">➕ Создать папку</button>
    <input type="file" id="file-input" multiple directory webkitdirectory accept=".html,.png,.svg,.txt,.css,.js,.json,.jpg,.jpeg,.gif,.webp" />
    <button onclick="document.getElementById('file-input').click()">⬆️ Загрузить файлы/папки</button>
    <button onclick="pasteItem()" id="paste-btn" style="display:none;">📋 Вставить</button>
    <button onclick="regenerateThumbnailsFast('<%= currentPath %>')">🔄 Обновить превьюшки</button>
    <div id="regenerate-progress-container">
      <div id="regenerate-progress-bar"></div>
      <div id="regenerate-progress-text">Загрузка...</div>
    </div>
  </div>

  <div id="drop-zone" ondrop="dropHandler(event);" ondragover="dragOverHandler(event);" ondragleave="dragLeaveHandler(event);">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;background:var(--hover-bg);border-radius:6px;">
      <span style="font-size:1.2rem;">📁</span>
      <span style="color:var(--accent);font-size:0.9rem;">Перетащите файлы сюда для загрузки</span>
    </div>
    <div id="progress-container">
      <div id="progress-bar"></div>
      <div id="progress-text">Загрузка...</div>
    </div>
  </div>

  <div class="items-grid" id="items-list">
    <% if (folders.length === 0 && files.length === 0) { %>
      <div class="empty-state">
        <p>📁 Папка <code>teletext/<%= currentPath ? currentPath + '/' : '' %></code> пуста</p>
        <p>Создайте папку или загрузите файлы</p>
      </div>
    <% } %>

    <% folders.forEach(folder => { %>
      <div class="item-card folder" data-name="<%= folder.name %>" data-type="folder">
        <div class="item-actions">
          <button title="Переименовать" onclick="openRenameModal('<%= folder.name %>', 'folder')">✏️</button>
          <button title="Вырезать" onclick="cutItem('<%= folder.name %>', 'folder')">✂️</button>
          <button title="Удалить" onclick="deleteItem('<%= folder.name %>', 'folder')">✕</button>
        </div>
        <a href="/manager/<%= encodeURIComponent(folder.path) %>" style="display:block;text-decoration:none;color:inherit;">
          <div class="item-preview">📁</div>
          <div class="item-name"><%= folder.name %></div>
          <div class="item-size"><%= folder.isEmpty ? 'пустая' : 'есть содержимое' %></div>
        </a>
      </div>
    <% }) %>

    <% files.forEach(file => { %>
      <div class="item-card file" data-name="<%= file.name %>" data-type="file">
        <div class="item-actions">
          <% if (file.ext === '.html') { %>
            <a href="/manager/edit-html/<%= encodeURIComponent(currentPath ? currentPath + '/' + file.name : file.name) %>" title="Редактировать HTML">📝</a>
          <% } %>
          <button title="Переименовать" onclick="openRenameModal('<%= file.name %>', 'file')">✏️</button>
          <button title="Вырезать" onclick="cutItem('<%= file.name %>', 'file')">✂️</button>
          <button title="Удалить" onclick="deleteItem('<%= file.name %>', 'file')">✕</button>
        </div>
        <div class="item-preview">
          <% if (file.ext === '.png') { %>
            <img src="<%= file.url %>" style="width:40px;height:40px;object-fit:cover;">
          <% } else { %>
            📄
          <% } %>
        </div>
        <div class="item-name"><%= file.name %></div>
        <div class="item-size"><%= Math.round(file.size / 1024) %> КБ</div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Модальное окно переименования -->
<div id="rename-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><div class="modal-title">✏️ Переименовать</div><span class="close" onclick="closeModal('rename-modal')">&times;</span></div>
    <div class="modal-body">
      <p>Введите новое имя для <strong id="rename-target-name"></strong>:</p>
      <input type="text" id="new-name-input" placeholder="Новое имя" style="width:100%;padding:8px;background:var(--hover-bg);border:1px solid var(--accent);color:var(--fg);border-radius:4px;font-family:var(--font-mono);">
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeModal('rename-modal')">Отмена</button>
      <button class="btn-action" onclick="performRename()">Переименовать</button>
    </div>
  </div>
</div>

<footer><a href="/" class="btn">🏠 На главную</a></footer>

<script>
// 🛡️ Перехват 401 → редирект на страницу входа
const _origFetch = window.fetch;
window.fetch = async (...args) => {
  const res = await _origFetch(...args);
  if (res.status === 401) {
    try {
      const data = await res.json().catch(() => ({}));
      window.location.href = data.redirect || '/login';
    } catch { window.location.href = '/login'; }
    return res;
  }
  return res;
};

const currentPath = `<%= currentPath %>`;
let currentOperationTarget = null;
let currentOperationType = null;

document.addEventListener('DOMContentLoaded', () => {
  if (localStorage.getItem('cutItemData')) document.getElementById('paste-btn').style.display = 'inline-block';
});

function openRenameModal(name, type) {
  currentOperationTarget = name; currentOperationType = type;
  document.getElementById('rename-target-name').textContent = name;
  document.getElementById('new-name-input').value = name;
  document.getElementById('rename-modal').style.display = 'flex';
}

function closeModal(modalId) {
  document.getElementById(modalId).style.display = 'none';
  currentOperationTarget = null; currentOperationType = null;
}

async function performRename() {
  const newName = document.getElementById('new-name-input').value.trim();
  if (!newName || !currentOperationTarget || !currentOperationType) return alert('Введите корректное имя.');
  try {
    const res = await fetch('/rename-item/' + encodeURIComponent(currentPath), {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ oldName: currentOperationTarget, newName: newName, type: currentOperationType })
    });
    const data = await res.json();
    if (res.ok) { closeModal('rename-modal'); location.reload(); } else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
}

async function cutItem(name, type) {
  localStorage.setItem('cutItemData', JSON.stringify({ name, type, sourcePath: currentPath }));
  alert(`✅ Элемент "${name}" вырезан. Перейдите в нужную папку и нажмите "Вставить".`);
  document.getElementById('paste-btn').style.display = 'inline-block';
}

async function pasteItem() {
  const saved = localStorage.getItem('cutItemData');
  if (!saved) return alert('Нет вырезанного элемента!');
  const data = JSON.parse(saved);
  if (data.sourcePath === currentPath) return alert('Нельзя вставить в ту же папку.');
  try {
    const res = await fetch('/move-item/' + encodeURIComponent(data.sourcePath), {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemName: data.name, targetPath: currentPath, type: data.type })
    });
    const json = await res.json();
    if (res.ok) { localStorage.removeItem('cutItemData'); document.getElementById('paste-btn').style.display = 'none'; location.reload(); } else alert(json.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
}

async function createFolder() {
  const name = document.getElementById('folder-name').value.trim();
  if (!name) return alert('Введите имя папки');
  try {
    const res = await fetch(`/create-folder/${encodeURIComponent(currentPath)}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name })
    });
    const data = await res.json();
    if (data.success) location.reload(); else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
}

document.getElementById('file-input').onchange = async (e) => {
  const files = Array.from(e.target.files); if (!files.length) return;
  const formData = new FormData(); files.forEach(f => formData.append('files', f));
  try {
    const res = await fetch(`/upload/${encodeURIComponent(currentPath)}`, { method: 'POST', body: formData });
    const data = await res.json(); if (data.success || data.saved) location.reload(); else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
};

function dragOverHandler(ev) { ev.preventDefault(); document.getElementById('drop-zone').classList.add('drag-over'); }
function dragLeaveHandler(ev) { ev.preventDefault(); document.getElementById('drop-zone').classList.remove('drag-over'); }
function dropHandler(ev) {
  ev.preventDefault(); document.getElementById('drop-zone').classList.remove('drag-over');
  const items = ev.dataTransfer.items;
  if (items) for (let i = 0; i < items.length; i++) if (items[i].webkitGetAsEntry()?.isDirectory) return alert('Загрузка папок через drag\'n\'drop не поддерживается. Используйте кнопку загрузки.');
  const files = Array.from(ev.dataTransfer.files); if (!files.length) return;
  const formData = new FormData(); files.forEach(f => formData.append('files', f)); uploadFiles(formData);
}

async function uploadFiles(formData) {
  const container = document.getElementById('progress-container');
  const bar = document.getElementById('progress-bar');
  const text = document.getElementById('progress-text');
  container.style.display = 'block'; let progress = 0;
  const interval = setInterval(() => { if (progress < 90) { progress += 5; bar.style.width = progress + '%'; text.textContent = `Загрузка... ${progress}%`; } }, 200);
  try {
    const res = await fetch(`/upload/${encodeURIComponent(currentPath)}`, { method: 'POST', body: formData });
    clearInterval(interval); const data = await res.json();
    if (data.success || data.saved) { bar.style.width = '100%'; text.textContent = '✅ Завершено!'; setTimeout(location.reload, 500); }
    else { bar.style.width = '100%'; text.textContent = '❌ Ошибка'; setTimeout(() => { alert(data.error || 'Ошибка'); container.style.display = 'none'; }, 1000); }
  } catch { clearInterval(interval); bar.style.width = '100%'; text.textContent = '❌ Ошибка сети'; setTimeout(() => { alert('Ошибка сети'); container.style.display = 'none'; }, 1000); }
}

async function deleteItem(name, type) {
  const txt = type === 'folder' ? `⚠️ Удалить папку "${name}" и всё содержимое?` : `Удалить файл "${name}"?`;
  if (!confirm(txt)) return;
  try {
    const res = await fetch('/delete-item/' + encodeURIComponent(currentPath), {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, type })
    });
    const data = await res.json(); if (data.success) location.reload(); else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
}

async function regenerateThumbnailsFast(path) {
  if (!confirm('Перегенерировать превьюшки в этой папке?')) return;
  const container = document.getElementById('regenerate-progress-container');
  const bar = document.getElementById('regenerate-progress-bar');
  const text = document.getElementById('regenerate-progress-text');
  container.style.display = 'block';
  try {
    const response = await fetch(`/manager/regenerate-thumbnails-fast/${encodeURIComponent(path)}`, { method: 'POST' });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const reader = response.body.getReader(); const decoder = new TextDecoder(); let buffer = '';
    while (true) {
      const { done, value } = await reader.read(); if (done) break;
      buffer += decoder.decode(value, { stream: true }); const lines = buffer.split('\n'); buffer = lines.pop();
      for (const line of lines) {
        if (!line.trim()) continue;
        try {
          const data = JSON.parse(line.trim());
          if (data.progress !== undefined) { bar.style.width = data.progress + '%'; text.textContent = `Перегенерация... ${data.progress}% (${data.current}/${data.total})`; }
          if (data.success === true) { bar.style.width = '100%'; text.textContent = '✅ Готово!'; setTimeout(location.reload, 500); return; }
          if (data.success === false) { throw new Error(data.error || 'Ошибка генерации'); }
        } catch (e) { console.error('Parse error:', line, e); }
      }
    }
  } catch (err) { text.textContent = '❌ ' + err.message; setTimeout(() => container.style.display = 'none', 2000); }
}
</script>
</body>
</html>