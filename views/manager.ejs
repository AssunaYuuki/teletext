<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>📁 Менеджер архивов</title>
<link rel="stylesheet" href="/global.css">
<style>
.manager-container { max-width: 1000px; margin: 0 auto; padding: 20px; }
.controls { background: var(--card-bg); padding: 15px; border-radius: 6px; border: 1px solid var(--accent); margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.controls input, .controls button { padding: 8px 12px; background: var(--hover-bg); border: 1px solid var(--accent); color: var(--fg); font-family: var(--font-mono); border-radius: 4px; }
.controls button { cursor: pointer; transition: all 0.2s ease; }
.controls button:hover { background: var(--accent); color: var(--bg); box-shadow: var(--glow); }
.breadcrumb { font-size: 0.9rem; margin-bottom: 10px; }
.breadcrumb a { color: var(--accent); text-decoration: none; }
.breadcrumb a:hover { text-decoration: underline; }
.items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
.item-card { background: var(--card-bg); border: 1px solid var(--accent); border-radius: 6px; padding: 10px; text-align: center; transition: all 0.2s ease; position: relative; }
.item-card:hover { background: var(--hover-bg); transform: translateY(-3px); box-shadow: 0 4px 12px var(--shadow); }
.item-card.folder { color: #ffcc00; }
.item-card.file { color: #a0d9a0; }
.item-actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; }
.item-actions button, .item-actions a { background: rgba(0,0,0,0.5); border: none; color: #ff6666; cursor: pointer; font-size: 0.8rem; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s; text-decoration: none; }
.item-actions button:hover, .item-actions a:hover { background: #ff6666; color: var(--bg); }
.item-preview { margin: 8px 0; font-size: 1.2rem; height: 40px; display: flex; align-items: center; justify-content: center; }
.item-preview img { width: 40px; height: 40px; object-fit: cover; border-radius: 3px; }
.icon-css { color: #264de4; font-weight: bold; font-family: monospace; }
.icon-js { color: #f7df1e; text-shadow: 0 0 2px #000; font-weight: bold; }
.icon-font { color: #ff6666; font-weight: bold; font-family: serif; }
.icon-html { color: #e34c26; font-weight: bold; font-family: monospace; }
.icon-img { color: #ff9966; }
.icon-default { color: #ccc; }
.item-name { font-size: 0.85rem; word-break: break-word; margin-top: 5px; }
.item-size { font-size: 0.75rem; opacity: 0.7; }
.empty-state { text-align: center; padding: 40px; opacity: 0.7; }
#drop-zone.drag-over { background: rgba(0,255,153,0.1); border-color: #00ffaa; }
#drop-zone.drag-over div { background: rgba(0,255,153,0.2); }
.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.7); justify-content: center; align-items: center; }
.modal-content { background: var(--card-bg); border: 2px solid var(--accent); border-radius: 6px; padding: 20px; max-width: 600px; width: 90%; box-shadow: 0 0 20px var(--glow); position: relative; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.modal-title { color: var(--accent); font-size: 1.2rem; }
.close { color: #ff6666; font-size: 1.5rem; font-weight: bold; cursor: pointer; }
.modal-body { color: var(--fg); font-size: 0.9rem; margin-bottom: 15px; }
.modal-footer { margin-top: 15px; text-align: right; }
.btn-action, .btn-cancel { padding: 6px 12px; border: 1px solid var(--accent); border-radius: 4px; cursor: pointer; margin-left: 6px; font-family: var(--font-mono); }
.btn-action { background: var(--card-bg); color: var(--accent); }
.btn-action:hover { background: var(--accent); color: var(--bg); }
.btn-cancel { background: var(--card-bg); color: var(--accent); }
.btn-cancel:hover { background: var(--accent); color: var(--bg); }
#progress-container, #regenerate-progress-container { display: none; margin-top: 10px; }
#progress-bar, #regenerate-progress-bar { height: 4px; background: var(--accent); width: 0%; border-radius: 2px; transition: width 0.3s ease; }
#progress-text, #regenerate-progress-text { font-size: 0.85rem; color: var(--accent); margin-top: 5px; }
.warning-box { background: rgba(255,204,0,0.1); border:1px solid #ffcc00; color:#ffcc00; padding:10px; border-radius:4px; margin-top:10px; font-size:0.85rem; display:none; }
</style>
</head>
<body>
<header class="nav-bar">
  <div class="breadcrumb">
    <a href="/">🏠</a> <a href="/manager/"> / teletext</a>
    <% if (breadcrumb && breadcrumb.length > 0) { %>
      <% breadcrumb.forEach((crumb, i) => { %>
        <% if (i === breadcrumb.length - 1) { %> <span> → <%= crumb.name %></span>
        <% } else { %> <a href="/manager/<%= encodeURIComponent(crumb.path) %>"> → <%= crumb.name %></a>
        <% } %>
      <% }) %>
    <% } %>
  </div>
  <h2>📁 Менеджер архивов</h2>
</header>

<div class="manager-container">
  <div class="controls">
    <input type="text" id="folder-name" placeholder="Имя новой папки">
    <button onclick="createFolder()">➕ Создать папку</button>
    <input type="file" id="file-input" multiple directory webkitdirectory accept="*/*" />
    <button onclick="document.getElementById('file-input').click()">⬆️ Загрузить файлы/папки</button>
    <button onclick="pasteItem()" id="paste-btn" style="display:none;">📋 Вставить</button>
    <button onclick="regenerateThumbnailsFast('<%= currentPath %>')">🔄 Обновить</button>
    <div id="regenerate-progress-container"><div id="regenerate-progress-bar"></div><div id="regenerate-progress-text">Загрузка...</div></div>
  </div>

  <div id="drop-zone" ondrop="dropHandler(event);" ondragover="dragOverHandler(event);" ondragleave="dragLeaveHandler(event);">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;background:var(--hover-bg);border-radius:6px;">
      <span style="font-size:1.2rem;">📁</span>
      <span style="color:var(--accent);font-size:0.9rem;">Перетащите файлы или ПАПКИ сюда (кроме .t42)</span>
    </div>
    <div id="progress-container"><div id="progress-bar"></div><div id="progress-text">Загрузка...</div></div>
    <div id="warnings-container" class="warning-box"></div>
  </div>

  <div class="items-grid" id="items-list">
    <% if (folders.length === 0 && files.length === 0) { %>
      <div class="empty-state"><p>📁 Папка пуста</p><p>Загрузите файлы (CSS, JS, TTF, HTML... кроме .t42)</p></div>
    <% } %>

    <% folders.forEach(folder => { %>
      <div class="item-card folder">
        <div class="item-actions">
          <button onclick="openRenameModal('<%= folder.name %>', 'folder')">✏️</button>
          <button onclick="cutItem('<%= folder.name %>', 'folder')">✂️</button>
          <button onclick="deleteItem('<%= folder.name %>', 'folder')">✕</button>
        </div>
        <a href="/manager/<%= encodeURIComponent(folder.path) %>" style="display:block;text-decoration:none;color:inherit;">
          <div class="item-preview">📁</div>
          <div class="item-name"><%= folder.name %></div>
          <div class="item-size"><%= folder.isEmpty ? 'пустая' : 'есть содержимое' %></div>
        </a>
      </div>
    <% }) %>

    <% files.forEach(file => { %>
      <div class="item-card file">
        <div class="item-actions">
          <% if (file.ext === '.html') { %><a href="/manager/edit-html/<%= encodeURIComponent(currentPath ? currentPath+'/'+file.name : file.name) %>">📝</a><% } %>
          <button onclick="openRenameModal('<%= file.name %>', 'file')">✏️</button>
          <button onclick="cutItem('<%= file.name %>', 'file')">✂️</button>
          <button onclick="deleteItem('<%= file.name %>', 'file')">✕</button>
        </div>
        <div class="item-preview">
          <% const ext = file.ext.toLowerCase(); %>
          <% if (['.png','.jpg','.jpeg','.gif','.webp','.svg'].includes(ext)) { %><span class="icon-img">🖼️</span><% }
             else if (ext === '.css') { %><span class="icon-css">CSS</span><% }
             else if (ext === '.js') { %><span class="icon-js">JS</span><% }
             else if (['.ttf','.otf','.woff','.woff2'].includes(ext)) { %><span class="icon-font">Aa</span><% }
             else if (ext === '.html') { %><span class="icon-html">HTML</span><% }
             else { %><span class="icon-default">📄</span><% } %>
        </div>
        <div class="item-name"><%= file.name %></div>
        <div class="item-size"><%= Math.round(file.size/1024) %> КБ</div>
      </div>
    <% }) %>
  </div>
</div>

<div id="rename-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><div class="modal-title">✏️ Переименовать</div><span class="close" onclick="closeModal('rename-modal')">&times;</span></div>
    <div class="modal-body">
      <p>Новое имя для <strong id="rename-target-name"></strong>:</p>
      <input type="text" id="new-name-input" style="width:100%;padding:8px;background:var(--hover-bg);border:1px solid var(--accent);color:var(--fg);border-radius:4px;font-family:var(--font-mono);">
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeModal('rename-modal')">Отмена</button>
      <button class="btn-action" onclick="performRename()">Переименовать</button>
    </div>
  </div>
</div>
<footer><a href="/" class="btn">🏠 На главную</a></footer>

<script>
const currentPath = `<%= currentPath %>`;
let currentOperationTarget = null, currentOperationType = null;

document.addEventListener('DOMContentLoaded', () => {
  if (localStorage.getItem('cutItemData')) document.getElementById('paste-btn').style.display = 'inline-block';
});

function openRenameModal(name, type) {
  currentOperationTarget = name; currentOperationType = type;
  document.getElementById('rename-target-name').textContent = name;
  document.getElementById('new-name-input').value = name;
  document.getElementById('rename-modal').style.display = 'flex';
}
function closeModal(id) { document.getElementById(id).style.display = 'none'; currentOperationTarget = null; currentOperationType = null; }

async function performRename() {
  const newName = document.getElementById('new-name-input').value.trim();
  if (!newName || !currentOperationTarget) return alert('Введите имя');
  try {
    const res = await fetch('/rename-item/' + encodeURIComponent(currentPath), {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ oldName: currentOperationTarget, newName, type: currentOperationType })
    });
    const data = await res.json();
    if (res.ok) { closeModal('rename-modal'); location.reload(); } else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
}

async function cutItem(name, type) {
  localStorage.setItem('cutItemData', JSON.stringify({ name, type, sourcePath: currentPath }));
  document.getElementById('paste-btn').style.display = 'inline-block';
  alert(`✅ "${name}" вырезан. Нажмите "Вставить" в нужной папке.`);
}

async function pasteItem() {
  const data = JSON.parse(localStorage.getItem('cutItemData'));
  if (!data || data.sourcePath === currentPath) return alert('Нет данных или та же папка');
  try {
    const res = await fetch('/move-item/' + encodeURIComponent(data.sourcePath), {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ itemName: data.name, targetPath: currentPath, type: data.type })
    });
    if (res.ok) { localStorage.removeItem('cutItemData'); document.getElementById('paste-btn').style.display = 'none'; location.reload(); }
    else alert((await res.json()).error);
  } catch { alert('Ошибка сети'); }
}

async function createFolder() {
  const name = document.getElementById('folder-name').value.trim();
  if (!name) return alert('Введите имя');
  try {
    const res = await fetch(`/create-folder/${encodeURIComponent(currentPath)}`, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name}) });
    if ((await res.json()).success) location.reload(); else alert((await res.json()).error);
  } catch { alert('Ошибка сети'); }
}

document.getElementById('file-input').onchange = async (e) => {
  const files = Array.from(e.target.files).filter(f => !f.name.toLowerCase().endsWith('.t42'));
  const t42Count = Array.from(e.target.files).filter(f => f.name.toLowerCase().endsWith('.t42')).length;
  if (t42Count > 0) console.log(`Пропущено .t42 файлов: ${t42Count}`);
  if (!files.length) return alert('Нет файлов для загрузки (все .t42 пропущены)');
  const fd = new FormData(); files.forEach(f => fd.append('files', f));
  try {
    const res = await fetch(`/upload/${encodeURIComponent(currentPath)}`, { method:'POST', body: fd });
    const data = await res.json();
    if (data.success) {
      if (data.skippedCount) console.log(`Пропущено файлов: ${data.skippedCount}`);
      location.reload();
    } else alert(data.error || 'Ошибка');
  } catch { alert('Ошибка сети'); }
};

function dragOverHandler(e) { e.preventDefault(); document.getElementById('drop-zone').classList.add('drag-over'); }
function dragLeaveHandler(e) { e.preventDefault(); document.getElementById('drop-zone').classList.remove('drag-over'); }

async function dropHandler(e) {
    e.preventDefault();
    document.getElementById('drop-zone').classList.remove('drag-over');

    const items = e.dataTransfer.items;
    if (!items) return;

    const filesToUpload = [];
    let rootFolderName = null;
    let totalFound = 0;
    let t42Skipped = 0;

    const readEntry = (entry) => new Promise(resolve => {
        if (entry.isFile) {
            entry.file(file => {
                totalFound++;
                if (!file.name.toLowerCase().endsWith('.t42')) {
                    filesToUpload.push(file);
                } else {
                    t42Skipped++;
                }
                resolve();
            });
        } else if (entry.isDirectory) {
            if (!rootFolderName) rootFolderName = entry.name;
            const dirReader = entry.createReader();

            // Читаем все entries (браузеры могут возвращать частями)
            const readAllEntries = () => {
                return new Promise((res) => {
                    const allEntries = [];
                    const readBatch = () => {
                        dirReader.readEntries(entries => {
                            if (entries.length === 0) {
                                res(allEntries);
                            } else {
                                allEntries.push(...entries);
                                readBatch();
                            }
                        });
                    };
                    readBatch();
                });
            };

            readAllEntries().then(async entries => {
                for (const ent of entries) {
                    await readEntry(ent);
                }
                resolve();
            });
        } else {
            resolve();
        }
    });


  await Promise.all(Array.from(items).map(i => i.webkitGetAsEntry()).filter(Boolean).map(readEntry));

  if (!filesToUpload.length) return alert('Нет файлов для загрузки (все .t42 пропущены)');

  const fd = new FormData();
  filesToUpload.forEach(f => fd.append('files', f));

  if (rootFolderName) {
    fd.append('targetFolderName', rootFolderName);
  }

  uploadFiles(fd);
}

async function uploadFiles(fd) {
  const box = document.getElementById('progress-container'), bar = document.getElementById('progress-bar'), txt = document.getElementById('progress-text'), warn = document.getElementById('warnings-container');
  box.style.display = 'block'; warn.style.display = 'none';
  let p = 0; const iv = setInterval(() => { if(p<90){p+=5; bar.style.width=p+'%'; txt.textContent=`Загрузка... ${p}%`; } }, 200);
  try {
    const res = await fetch(`/upload/${encodeURIComponent(currentPath)}`, { method:'POST', body: fd });
    clearInterval(iv); const data = await res.json();
    if (data.success) {
      bar.style.width='100%'; txt.textContent='✅ Готово!';
      if (data.warnings) { warn.style.display='block'; warn.innerHTML='<b>Внимание:</b><br>'+data.warnings.join('<br>'); }
      if (data.skippedCount) { warn.style.display='block'; warn.innerHTML += `<br>Пропущено .t42 файлов: ${data.skippedCount}`; }
      setTimeout(location.reload, 1500);
    } else {
      bar.style.width='100%'; txt.textContent='❌ Ошибка';
      setTimeout(()=>{ alert(data.error); box.style.display='none'; }, 2000);
    }
  } catch { clearInterval(iv); alert('Ошибка сети'); box.style.display='none'; }
}

async function deleteItem(name, type) {
  if (!confirm(type==='folder' ? `Удалить "${name}" и всё внутри?` : `Удалить "${name}"?`)) return;
  try {
    const res = await fetch('/delete-item/' + encodeURIComponent(currentPath), { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name,type}) });
    if ((await res.json()).success) location.reload(); else alert((await res.json()).error);
  } catch { alert('Ошибка сети'); }
}

async function regenerateThumbnailsFast(path) {
  if (!confirm('Перегенерировать превью?')) return;
  const c = document.getElementById('regenerate-progress-container'), b = document.getElementById('regenerate-progress-bar'), t = document.getElementById('regenerate-progress-text');
  c.style.display = 'block';
  try {
    const r = await fetch(`/manager/regenerate-thumbnails-fast/${encodeURIComponent(path)}`, {method:'POST'});
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    const reader = r.body.getReader(), dec = new TextDecoder(); let buf = '';
    while(true) {
      const {done, value} = await reader.read(); if(done) break;
      buf += dec.decode(value, {stream:true}); const lines = buf.split('\n'); buf = lines.pop();
      for (const l of lines) {
        if (!l.trim()) continue;
        try {
          const d = JSON.parse(l.trim());
          if (d.progress !== undefined) { b.style.width=d.progress+'%'; t.textContent=`Генерация... ${d.progress}%`; }
          if (d.success === true) { b.style.width='100%'; t.textContent='✅ Готово!'; setTimeout(location.reload,500); return; }
          if (d.success === false) throw new Error(d.error);
        } catch(e) { console.error(e); }
      }
    }
  } catch(e) { t.textContent='❌ '+e.message; setTimeout(()=>c.style.display='none',2000); }
}
</script>
</body>
</html>